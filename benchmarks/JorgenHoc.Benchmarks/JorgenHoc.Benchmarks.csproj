<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props.
         Optimize is required: BenchmarkDotNet refuses to run a Debug build, and Debug
         timings would be meaningless anyway. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings EF Core SqlServer (and Microsoft.Data.SqlClient) transitively. -->
    <ProjectReference Include="..\..\shared\JorgenHoc.DataAccess\JorgenHoc.DataAccess.csproj" />
  </ItemGroup>

</Project>
